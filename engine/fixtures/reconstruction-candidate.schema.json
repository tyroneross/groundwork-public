{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Groundwork reconstruction candidate v1",
  "type": "object",
  "required": ["schema", "contractDigest", "root", "artifacts", "measurements", "assertions", "verificationResults"],
  "properties": {
    "schema": { "const": "groundwork.reconstruction-candidate/v1" },
    "contractDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "root": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "measurements": {
      "type": "array",
      "items": { "$ref": "#/$defs/measurement" }
    },
    "assertions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assertion" }
    },
    "verificationResults": {
      "type": "array",
      "items": { "$ref": "#/$defs/verificationResult" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["id", "path", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["constraintId", "targetRef", "propertyPath", "actualValue", "artifactId", "evidenceLocator"],
      "properties": {
        "constraintId": { "type": "string", "minLength": 1 },
        "targetRef": { "type": "string", "minLength": 1 },
        "propertyPath": { "type": "string", "minLength": 1 },
        "actualValue": {},
        "unit": { "type": "string", "minLength": 1 },
        "artifactId": { "type": "string", "minLength": 1 },
        "evidenceLocator": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["verificationId", "targetRef", "propertyPath", "actualValue", "artifactId", "evidenceLocator"],
      "properties": {
        "verificationId": { "type": "string", "minLength": 1 },
        "targetRef": { "type": "string", "minLength": 1 },
        "propertyPath": { "type": "string", "minLength": 1 },
        "actualValue": {},
        "artifactId": { "type": "string", "minLength": 1 },
        "evidenceLocator": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "verificationResult": {
      "type": "object",
      "required": ["verificationId", "status", "evidence"],
      "properties": {
        "verificationId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["artifactId", "locator"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
