    "direction": {
      "summary": "Keep attention on the next realistic action.",
      "mustPreserve": [
        "compact hierarchy"
      ],
      "mayVary": [
        "related palette"
      ]
    },
    "deltas": [
      {
        "id": "delta-source-health",
        "baselineId": "baseline-sample-planner-day-v4",
        "targetRefs": [
          "screen-planner"
        ],
        "operation": "remove",
        "before": "source health",
        "after": null,
        "direction": "Remove irrelevant status."
      }
    ],
    "verification": [
      {
        "id": "verify-save",
        "kind": "assertion",
        "targetRefs": [
          "screen-planner"
        ],
        "method": "Evaluate save.prohibitedWrites against the DOM and verification contracts.",
        "passCriteria": [
          {
            "subjectRef": "screen-planner",
            "propertyPath": "save.prohibitedWrites",
            "operator": "contains",
            "value": "calendar/Event/create"
          }
        ]
      },
      {
        "id": "verify-calendar-confirmation",
        "kind": "assertion",
        "targetRefs": [
          "screen-planner"
        ],
        "method": "integration",
        "passCriteria": [
          {
            "subjectRef": "screen-planner",
            "propertyPath": "calendar.write.requiresConfirmation",
            "operator": "eq",
            "value": true
          }
        ]
      },
      {
        "id": "verify-target",
        "kind": "ibr",
        "targetRefs": [
          "element-save"
        ],
        "method": "IBR computed-style, DOM, screenshot, and accessibility comparison",
        "passCriteria": [
          {
            "subjectRef": "element-save",
            "propertyPath": "minimumTouchTarget",
            "operator": "gte",
            "value": 48
          },
          {
            "subjectRef": "element-save",
            "propertyPath": "background.gradient.start",
            "operator": "in",
            "value": [
              "#3F96F2"
            ]
          },
          {
            "subjectRef": "screen-planner",
            "propertyPath": "schedule.defaultExpanded",
            "operator": "not-in",
            "value": [
              true
            ]
          }
        ]
      }
    ]
  },
