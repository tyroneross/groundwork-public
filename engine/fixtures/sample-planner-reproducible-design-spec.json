    "constraints": [
      {
        "id": "constraint-save-boundary",
        "kind": "behavioral",
        "scope": {
          "kind": "screen",
          "refs": [
            "screen-planner"
          ]
        },
        "targetRef": "screen-planner",
        "propertyPath": "save.prohibitedWrites",
        "operator": "eq",
        "value": "calendar/Event/create",
        "sourceArtifactId": "artifact-dom",
        "verificationRefs": [
          "verify-save"
        ]
      },
      {
        "id": "constraint-confirm-calendar-write",
        "kind": "architectural",
        "scope": {
          "kind": "product",
          "refs": [
            "spec-sample-planner-reconstruction"
          ]
        },
        "targetRef": "screen-planner",
        "propertyPath": "calendar.write.requiresConfirmation",
        "operator": "eq",
        "value": true,
        "sourceArtifactId": "artifact-verification",
        "verificationRefs": [
          "verify-calendar-confirmation"
        ]
      },
      {
        "id": "constraint-action-target",
        "kind": "exact",
        "scope": {
          "kind": "element",
          "refs": [
            "element-save"
          ]
        },
        "targetRef": "element-save",
        "propertyPath": "minimumTouchTarget",
        "operator": "gte",
        "value": 48,
        "unit": "px",
        "tolerance": 0,
        "sourceArtifactId": "artifact-layout",
        "verificationRefs": [
          "verify-target"
        ]
      },
      {
        "id": "constraint-action-radius",
        "kind": "exact",
        "scope": {
          "kind": "element",
          "refs": [
            "element-save"
          ]
        },
        "targetRef": "element-save",
        "propertyPath": "borderRadius",
        "operator": "eq",
        "value": 14,
        "unit": "px",
        "tolerance": 0,
        "sourceArtifactId": "artifact-tokens",
        "verificationRefs": [
          "verify-target"
        ]
      },
      {
        "id": "constraint-action-color-start",
        "kind": "exact",
        "scope": {
          "kind": "element",
          "refs": [
            "element-save"
          ]
        },
        "targetRef": "element-save",
        "propertyPath": "background.gradient.start",
        "operator": "eq",
        "value": "#3F96F2",
        "sourceArtifactId": "artifact-tokens",
        "verificationRefs": [
          "verify-target"
        ]
      },
      {
        "id": "constraint-action-color-end",
        "kind": "exact",
        "scope": {
          "kind": "element",
          "refs": [
            "element-save"
          ]
        },
        "targetRef": "element-save",
        "propertyPath": "background.gradient.end",
        "operator": "eq",
        "value": "#2563EB",
        "sourceArtifactId": "artifact-tokens",
        "verificationRefs": [
          "verify-target"
        ]
      },
      {
        "id": "constraint-action-gradient-angle",
        "kind": "exact",
        "scope": {
          "kind": "element",
          "refs": [
            "element-save"
          ]
        },
        "targetRef": "element-save",
        "propertyPath": "background.gradient.angle",
        "operator": "eq",
        "value": 135,
        "unit": "deg",
        "tolerance": 0,
        "sourceArtifactId": "artifact-tokens",
        "verificationRefs": [
          "verify-target"
        ]
      },
      {
        "id": "constraint-action-order",
        "kind": "exact",
        "scope": {
          "kind": "screen",
          "refs": [
            "screen-planner"
          ]
        },
        "targetRef": "screen-planner",
        "propertyPath": "actionBar.order",
        "operator": "eq",
        "value": [
          "action.calendar.beginExport",
          "action.plan.save"
        ],
        "sourceArtifactId": "artifact-layout",
        "verificationRefs": [
          "verify-target"
        ]
      },
      {
        "id": "constraint-schedule-collapsed",
        "kind": "exact",
        "scope": {
          "kind": "screen",
          "refs": [
            "screen-planner"
          ]
        },
        "targetRef": "screen-planner",
        "propertyPath": "schedule.defaultExpanded",
        "operator": "eq",
        "value": false,
        "sourceArtifactId": "artifact-dom",
        "verificationRefs": [
          "verify-target"
        ]
      },
      {
        "id": "constraint-viewport-width",
        "kind": "exact",
        "scope": {
          "kind": "screen",
          "refs": [
            "screen-planner"
          ]
        },
        "targetRef": "screen-planner",
        "propertyPath": "viewport.width",
        "operator": "eq",
        "value": 430,
        "unit": "px",
        "tolerance": 0,
        "sourceArtifactId": "artifact-screenshot",
        "verificationRefs": [
          "verify-target"
        ]
      },
      {
        "id": "constraint-viewport-height",
        "kind": "exact",
        "scope": {
          "kind": "screen",
          "refs": [
            "screen-planner"
          ]
        },
        "targetRef": "screen-planner",
        "propertyPath": "viewport.height",
        "operator": "eq",
        "value": 932,
        "unit": "px",
        "tolerance": 0,
        "sourceArtifactId": "artifact-screenshot",
        "verificationRefs": [
          "verify-target"
        ]
      },
      {
        "id": "constraint-action-gap",
        "kind": "exact",
        "scope": {
          "kind": "screen",
          "refs": [
            "screen-planner"
          ]
        },
        "targetRef": "screen-planner",
        "propertyPath": "actionBar.gap",
        "operator": "eq",
        "value": 12,
        "unit": "px",
        "tolerance": 0,
        "sourceArtifactId": "artifact-layout",
        "verificationRefs": [
          "verify-target"
        ]
      },
      {
        "id": "constraint-body-font-size",
        "kind": "exact",
        "scope": {
          "kind": "screen",
          "refs": [
            "screen-planner"
          ]
        },
        "targetRef": "screen-planner",
        "propertyPath": "typography.body.fontSize",
        "operator": "eq",
        "value": 16,
        "unit": "px",
        "tolerance": 0,
        "sourceArtifactId": "artifact-html",
        "verificationRefs": [
          "verify-target"
        ]
      },
      {
        "id": "constraint-save-label",
        "kind": "exact",
        "scope": {
          "kind": "element",
          "refs": [
            "element-save"
          ]
        },
        "targetRef": "element-save",
        "propertyPath": "accessibility.label",
        "operator": "eq",
        "value": "Save plan",
        "sourceArtifactId": "artifact-a11y",
        "verificationRefs": [
