{
  "schemaVersion": 3,
  "id": "spec-sample-planner-reconstruction",
  "productName": "Sample Planner",
  "productDescription": "A guided daily planner with explicit local and calendar write boundaries.",
  "platformTarget": "ios",
  "platformSurfaces": [
    {
      "id": "surface-ios",
      "platform": "ios",
      "role": "primary",
      "name": "iOS",
      "interactionModes": [
        "touch"
      ],
      "featureIds": [
        "feature-plan"
      ],
      "provenance": "observed"
    }
  ],
  "needs": [
    {
      "id": "need-plan",
      "title": "Build a realistic day",
      "priority": "P0"
    }
  ],
  "features": [
    {
      "id": "feature-plan",
      "title": "Guided day planning",
      "surface": "ui",
      "priority": "P0",
      "needIds": [
        "need-plan"
      ]
    }
  ],
  "screens": [
    {
      "id": "screen-planner",
      "name": "Planner",
      "purpose": "Build a realistic day.",
      "featureIds": [
        "feature-plan"
      ],
      "states": [
        "preview"
      ],
      "elements": [
        {
          "id": "element-save",
          "name": "Save plan",
          "role": "primary action"
        }
      ]
    }
  ],
  "tests": [
    {
      "id": "test-plan",
      "description": "Planner preserves the reviewed schedule and write boundaries.",
      "needIds": [
        "need-plan"
      ],
      "featureIds": [
        "feature-plan"
      ],
      "screenIds": [
        "screen-planner"
      ],
      "platformSurfaceIds": [
        "surface-ios"
      ],
      "kind": "acceptance",
      "testFramework": "XCTest"
    }
  ],
  "behaviorContracts": [
    {
      "id": "behavior-save-control",
      "name": "Save control",
      "scope": {
        "kind": "element",
        "refs": [
          "element-save"
        ]
      },
      "trigger": "User activates Save plan",
      "states": [],
      "actions": [],
      "transitions": [],
      "verificationRefs": [
        "verify-target"
      ]
    },
    {
      "id": "behavior-planner",
      "name": "Planner preview",
      "scope": {
        "kind": "screen",
        "refs": [
          "screen-planner"
        ]
      },
      "trigger": "User reviews the plan",
      "states": [
        {
          "id": "state-preview",
          "name": "Preview"
        }
      ],
      "actions": [
        {
          "id": "action-save",
          "name": "Save plan",
          "fromStateIds": [
            "state-preview"
          ],
          "effects": [
            {
              "kind": "update",
              "targetRef": "screen-planner"
            }
          ],
          "writes": [
            {
              "storeRef": "local-plan",
              "entity": "DailyPlan",
              "fields": [
                "blocks"
              ],
              "mode": "update"
            }
          ],
          "prohibitedWrites": [
            {
              "storeRef": "calendar",
              "entity": "Event",
              "fields": [],
              "mode": "create"
            }
          ],
          "feedback": {
            "channel": "toast",
            "timing": "immediate",
            "message": "Plan saved locally."
          }
        }
      ],
      "transitions": []
    }
  ],
  "adrs": [
    {
      "id": "adr-save-control-style",
      "title": "Save control style",
      "context": "Planner action",
      "decision": "Keep the save control in the action family.",
      "reversibility": "high",
      "rigidity": "leaning",
      "scope": {
        "kind": "element",
        "refs": [
          "element-save"
        ]
      }
    },
    {
      "id": "adr-save-boundary",
      "title": "Save stays local",
      "context": "Planner writes",
      "decision": "Calendar export remains separate.",
      "reversibility": "medium",
      "rigidity": "locked",
      "scope": {
        "kind": "screen",
        "refs": [
          "screen-planner"
        ]
      },
      "constraintRefs": [
        "constraint-save-boundary"
      ]
    },
    {
      "id": "adr-action-style",
      "title": "Action family",
      "context": "Planner style",
      "decision": "Use related blue-indigo actions.",
      "reversibility": "high",
      "rigidity": "leaning",
      "scope": {
        "kind": "screen",
        "refs": [
          "screen-planner"
        ]
      },
      "mustPreserve": [
        "accessible contrast"
      ],
      "mayVary": [
        "gradient intensity"
      ]
    }
  ],
  "designContract": {
    "baseline": {
      "disposition": "declared",
      "id": "baseline-sample-planner-day-v4",
