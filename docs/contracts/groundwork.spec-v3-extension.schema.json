{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundwork.local/contracts/groundwork.spec-v3-extension.schema.json",
  "title": "Groundwork Spec v3 extension contract",
  "type": "object",
  "required": ["schemaVersion", "id", "platformTarget", "platformSurfaces", "architecture", "governance", "changeSet"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "id": { "$ref": "#/$defs/id" },
    "platformTarget": { "$ref": "#/$defs/platform" },
    "platformSurfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/platformSurface" }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "ownedFiles": { "$ref": "#/$defs/ownedFiles" },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "name": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "ownedFiles": { "$ref": "#/$defs/ownedFiles" }
        }
      }
    },
    "projectContext": {
      "type": "object",
      "properties": {
        "declaredNewFiles": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "because"],
            "properties": { "path": { "$ref": "#/$defs/ownedFile" }, "because": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "architecture": { "$ref": "#/$defs/architecture" },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraints"],
      "properties": {
        "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "owners": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "changeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "current", "proposed", "verified"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "current": { "type": "array", "items": { "$ref": "#/$defs/changeRecord" } },
        "proposed": { "type": "array", "items": { "$ref": "#/$defs/changeRecord" } },
        "verified": { "type": "array", "items": { "$ref": "#/$defs/changeRecord" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ownedFile": { "type": "string", "minLength": 1, "format": "groundwork-owned-file", "pattern": "^(?!/|~)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[\\\\\\\\\\u0000])(?!.*%(?![0-9A-Fa-f]{2}))(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:^|/)(?:\\.[gG][iI][tT]|\\.[sS][sS][hH]|\\.[aA][wW][sS]|\\.[gG][nN][uU][pP][gG]|\\.[eE][nN][vV](?:\\.(?![eE][xX][aA][mM][pP][lL][eE](?:/|$))[^/]+)?|[sS][eE][cC][rR][eE][tT][sS]?|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS](?:\\.[^./]+)?|[iI][dD]_(?:[rR][sS][aA]|[dD][sS][aA]|[eE][cC][dD][sS][aA]|[eE][dD]25519))(?=/|$)).+$" },
    "ownedFiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ownedFile" } },
    "platform": { "enum": ["web", "vite-spa", "ios", "macos", "watchos", "tvos", "visionos", "android", "claude-plugin", "agent-system", "api", "service", "other"] },
    "provenance": { "enum": ["observed", "decided", "assumed", "derived"] },
    "platformSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "platform", "role", "name", "interactionModes", "featureIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "platform": { "$ref": "#/$defs/platform" },
        "role": { "enum": ["primary", "companion", "admin", "extension", "service"] },
        "name": { "type": "string", "minLength": 1 },
        "interactionModes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "featureIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "qualifiedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specId", "kind", "id"],
      "properties": {
        "specId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["component", "contract", "feature", "screen", "element", "requirement", "flow", "task"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "direction"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["input", "output", "bidirectional"] },
        "required": { "type": "boolean", "default": true }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "featureIds", "owner"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["ui", "service", "data", "integration", "agent", "library", "platform"] },
        "featureIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "owner": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "ownedFiles": { "$ref": "#/$defs/ownedFiles" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "provider", "consumers", "ports", "transport", "failureModes", "securityNotes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "provider": { "$ref": "#/$defs/qualifiedRef" },
        "consumers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/qualifiedRef" }, "uniqueItems": true },
        "ports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/port" } },
        "transport": { "type": "string", "minLength": 1 },
        "failureModes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "securityNotes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "ownedFiles": { "$ref": "#/$defs/ownedFiles" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "direction", "criticality", "optional", "rationale"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/qualifiedRef" },
        "to": { "$ref": "#/$defs/qualifiedRef" },
        "direction": { "enum": ["unidirectional", "bidirectional", "event"] },
        "contractRef": { "$ref": "#/$defs/qualifiedRef" },
        "criticality": { "enum": ["hard", "soft", "informational"] },
        "optional": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "from", "to", "contractRef", "inputRefs", "outputRefs", "failurePaths"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1 },
        "from": { "$ref": "#/$defs/qualifiedRef" },
        "to": { "$ref": "#/$defs/qualifiedRef" },
        "contractRef": { "$ref": "#/$defs/qualifiedRef" },
        "inputRefs": { "type": "array", "items": { "$ref": "#/$defs/qualifiedRef" } },
        "outputRefs": { "type": "array", "items": { "$ref": "#/$defs/qualifiedRef" } },
        "failurePaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "trigger", "exchanges"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "exchanges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/exchange" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "specDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "specId", "location", "schemaVersion", "revision", "digest", "relationship"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "specId": { "$ref": "#/$defs/id" },
        "location": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "local" }, "path": { "type": "string", "minLength": 1 } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "uri"], "properties": { "kind": { "const": "uri" }, "uri": { "type": "string", "format": "uri" } } }
          ]
        },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "relationship": { "enum": ["uses", "extends", "implements", "companion"] },
        "optional": { "type": "boolean", "default": false }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "contracts", "relationships", "flows", "specDependencies"],
      "properties": {
        "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
        "contracts": { "type": "array", "items": { "$ref": "#/$defs/contract" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
        "flows": { "type": "array", "items": { "$ref": "#/$defs/flow" } },
        "specDependencies": { "type": "array", "items": { "$ref": "#/$defs/specDependency" } }
      }
    },
    "changeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "summary", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/qualifiedRef" },
        "summary": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    }
  }
}
