#!/bin/sh
# Optional local Rally capture. Its helper is installed per machine and is
# deliberately not part of the distributable repository.
HOOK_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)" || exit 0
CAPTURE="$HOOK_DIR/.rally-point-capture.py"
if [ -f "$CAPTURE" ]; then
  ( python3 "$CAPTURE" >/dev/null 2>&1 ) </dev/null >/dev/null 2>&1 &
fi
exit 0
